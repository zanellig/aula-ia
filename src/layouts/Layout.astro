---
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import { HeaderAuth } from "../components/HeaderAuth";
import "../styles/app.css";

interface Props {
	title: string;
}
const { title } = Astro.props;

const navLink =
	"text-sm whitespace-nowrap text-muted-foreground transition-colors hover:text-foreground aria-[current=page]:font-medium aria-[current=page]:text-foreground";
const current = (path: string) =>
	Astro.url.pathname === path ? "page" : undefined;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<!-- Spanish only needs the latin subset. Preloaded so it isn't found late, after the CSS. -->
		<link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<!-- Before first paint: pick the header's placeholder (see src/lib/session.ts). -->
		<script is:inline>
			document.documentElement.dataset.auth = document.cookie.split("; ").includes("aula_signed_in=1") ? "in" : "out";
		</script>
	</head>
	<body class="flex min-h-svh flex-col bg-background text-foreground antialiased">
		<header class="border-b">
			<div class="mx-auto flex h-14 max-w-5xl items-center gap-4 px-4 sm:gap-6">
				<a href="/" class="flex shrink-0 items-center gap-2 font-semibold whitespace-nowrap">
					<img src="/favicon.svg" alt="" class="size-6" />
					Aula IA
				</a>
				<nav class="flex items-center gap-4">
					<!-- Below sm the logo already links home; this keeps the header within 320 px. -->
					<a href="/" class={`${navLink} hidden sm:inline`} aria-current={current("/")}>Profesores</a>
					<a href="/mis-clases" class={navLink} aria-current={current("/mis-clases")}>Mis clases</a>
				</nav>
				<HeaderAuth client:load />
			</div>
		</header>
		<!-- A flex column filling the viewport, so a page can center itself with my-auto. -->
		<main class="mx-auto flex w-full max-w-5xl flex-1 flex-col px-4 py-8">
			<slot />
		</main>
	</body>
</html>
